# Jenkins stack — keep this file out of git (chmod 600 .env)

# Required
# Pin an exact LTS release from Docker Hub, e.g. 2.xxx.x-lts-alpine-jdk25
JENKINS_TAG=2.580.1-alpine-jdk25
# Full hostname Jenkins is served on (a subdomain covered by the Traefik wildcard)
DOMAIN=jenkins.kostelidis.dev

# Access control for the web UI.
# Comma-separate multiple ranges. The defaults in docker-compose.yaml allow everyone.
IPV4_ALLOWLIST=0.0.0.0/0
IPV6_ALLOWLIST=::/0

# Optional overrides
TZ=Europe/Athens
JENKINS_HEAP_PERCENT=60
JENKINS_CPU_LIMIT=2
JENKINS_MEMORY_LIMIT=2G
JENKINS_MEMORY_RESERVATION=1G
JENKINS_PIDS_LIMIT=2048
